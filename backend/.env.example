# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# Distributed Cache (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="your-256-bit-jwt-secret-key-here"
ADMIN_API_KEY="your-strong-admin-x-api-key"

# Third-Party Market Data APIs
INDIANAPI_KEY="your_indianapi_key_here"
INDIANAPI_BASE_URL="https://dev.indianapi.in"

# Upstox Developer API
UPSTOX_API_KEY="your_upstox_api_key_here"
UPSTOX_API_SECRET="your_upstox_api_secret_here"
UPSTOX_REDIRECT_URI="http://localhost:5000/api/v1/stocks/upstox/callback"
